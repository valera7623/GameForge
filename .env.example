# AI Game Dev Toolkit / GameForge

APP_NAME=AI Game Dev Toolkit
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-use-openssl-rand-hex-32
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost,http://frontend:3000
FRONTEND_URL=http://localhost:3000

# saas | onprem
DEPLOYMENT_MODE=saas
DISABLE_BILLING=false
FORCE_PLAN=
LICENSE_KEY=
STUDIO_SEATS=5

# Database
DATABASE_URL=postgresql+asyncpg://gamedev:gamedev@postgres:5432/gamedev
DATABASE_URL_SYNC=postgresql://gamedev:gamedev@postgres:5432/gamedev
POSTGRES_USER=gamedev
POSTGRES_PASSWORD=gamedev
POSTGRES_DB=gamedev

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# AI — ProxyAPI (https://proxyapi.ru)
USE_MOCK_AI=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1
OPENAI_MODEL=gpt-4o
STABILITY_API_KEY=
ELEVENLABS_API_KEY=

# Real-ESRGAN microservice (optional): docker compose --profile ai up -d
REALESRGAN_URL=
# REPLICATE for MusicGen
REPLICATE_API_TOKEN=
MUSICGEN_MODEL=meta/musicgen:671ac645ce5e552cc63a54a2bbff63fcf798043055d2dac5fc9e36a837932052

# Email: console | smtp | resend
EMAIL_PROVIDER=console
EMAIL_FROM=GameForge <noreply@gamedev.ai>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
RESEND_API_KEY=

# MinIO / S3
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=gamedev-assets
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000/gamedev-assets

# Billing
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_INDIE=
STRIPE_PRICE_STUDIO=
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=

# Plans
FREE_GENERATIONS=5
INDIE_GENERATIONS=100
STUDIO_GENERATIONS=1000

# Domain (production Traefik)
DOMAIN=localhost
ACME_EMAIL=admin@example.com
