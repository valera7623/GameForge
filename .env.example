# AI Game Dev Toolkit / GameForge

APP_NAME=AI Game Dev Toolkit
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-use-openssl-rand-hex-32
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost,http://frontend:3000
FRONTEND_URL=http://localhost:3000

# saas | onprem
DEPLOYMENT_MODE=saas
DISABLE_BILLING=false
FORCE_PLAN=
LICENSE_KEY=
STUDIO_SEATS=5

# Database
DATABASE_URL=postgresql+asyncpg://gamedev:gamedev@postgres:5432/gamedev
DATABASE_URL_SYNC=postgresql://gamedev:gamedev@postgres:5432/gamedev
POSTGRES_USER=gamedev
POSTGRES_PASSWORD=gamedev
POSTGRES_DB=gamedev

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# AI — ProxyAPI (https://proxyapi.ru)
USE_MOCK_AI=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1
OPENAI_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=gpt-image-1-mini
# Character images: auto (openai then stability) | openai | stability
IMAGE_PROVIDER=auto
# Cloud Stable Image API — https://platform.stability.ai → API Keys (no local SD)
STABILITY_API_KEY=
# core | ultra | sd3 (=sd3.5-large) | sd3.5-large | sd3.5-large-turbo | sd3.5-medium | sd3.5-flash
STABILITY_IMAGE_MODEL=core
ELEVENLABS_API_KEY=

# Real-ESRGAN microservice (optional): docker compose --profile ai up -d
REALESRGAN_URL=
# REPLICATE for MusicGen
REPLICATE_API_TOKEN=
MUSICGEN_MODEL=meta/musicgen:671ac645ce5e552cc63a54a2bbff63fcf798043055d2dac5fc9e36a837932052

# Email: console | smtp | resend  (production: smtp|resend only)
EMAIL_PROVIDER=console
EMAIL_FROM=GameForge <noreply@gamedev.ai>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
RESEND_API_KEY=
# Temporary only — allows console/missing mail keys while APP_ENV=production
ALLOW_INSECURE_EMAIL=false

# MinIO / S3
S3_ENDPOINT=http://minio:9000
# Browser-facing MinIO via Caddy (prod): https://your.domain/s3
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=gamedev-assets
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000/gamedev-assets

# Billing
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_INDIE=
STRIPE_PRICE_STUDIO=
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=

ALLOW_MOCK_BILLING=true
COOKIE_SECURE=false
S3_USE_SIGNED_URLS=true
S3_PUBLIC_READ=false
SENTRY_DSN=
LOG_JSON=false
OPENAI_TIMEOUT_SEC=180

# Frontend analytics (baked into Vite build — rebuild frontend after change)
# GA4 Measurement ID from Google Analytics → Admin → Data streams
VITE_GA_MEASUREMENT_ID=

# Plans
FREE_GENERATIONS=5
INDIE_GENERATIONS=100
STUDIO_GENERATIONS=1000

# Domain (production Caddy / HTTPS)
DOMAIN=gameforge.website
ACME_EMAIL=admin@example.com

# ---------------------------------------------------------------------------
# Production checklist (APP_ENV=production)
# ---------------------------------------------------------------------------
# APP_ENV=production
# DEBUG=false
# SECRET_KEY=<openssl rand -hex 32>   # not a change-me* placeholder, ≥32 chars
# FRONTEND_URL=https://gameforge.website
# CORS_ORIGINS=https://gameforge.website,https://www.gameforge.website
# COOKIE_SECURE=true
# ALLOW_MOCK_BILLING=false
# USE_MOCK_AI=true          # true = free mock AI (no provider spend); false = real APIs
# OPENAI_API_KEY=<required when USE_MOCK_AI=false>
# EMAIL_PROVIDER=resend   # or smtp — console forbidden unless ALLOW_INSECURE_EMAIL=true
# EMAIL_FROM=GameForge <noreply@gameforge.website>
# RESEND_API_KEY=...      # or SMTP_* for smtp
# DISABLE_BILLING=true    # until Stripe/YuKassa keys exist
# S3_ENDPOINT=http://minio:9000
# S3_PUBLIC_ENDPOINT=https://gameforge.website/s3
# S3_PUBLIC_URL=https://gameforge.website/s3/gamedev-assets
# LOG_JSON=true
# SENTRY_DSN=             # optional
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX   # rebuild frontend after set
# DOMAIN=gameforge.website
# ACME_EMAIL=you@example.com
# DNS: @ and www → A  <VPS_IP>  (www must not CNAME to a bare IP)
# DNS: docs → A  <VPS_IP>  (MkDocs at https://docs.<domain>)
