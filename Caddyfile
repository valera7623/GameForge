{
	email {$ACME_EMAIL:admin@example.com}
	auto_https disable_redirects
}

http://, http://{$DOMAIN:localhost}, http://www.{$DOMAIN:localhost} {
	redir https://{$DOMAIN:localhost}{uri} permanent
}

http://docs.{$DOMAIN:localhost} {
	redir https://docs.{$DOMAIN:localhost}{uri} permanent
}

https://www.{$DOMAIN:localhost} {
	redir https://{$DOMAIN:localhost}{uri} permanent
}

https://docs.{$DOMAIN:localhost} {
	encode gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	reverse_proxy docs:80
}

https://{$DOMAIN:localhost} {
	encode gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

	# Public MinIO (path-style): https://$DOMAIN/s3/<bucket>/<key>
	# Strip /s3; keep upstream Host so SigV4 (signed for minio:9000) still verifies.
	handle_path /s3/* {
		reverse_proxy minio:9000 {
			header_up Host minio:9000
		}
	}

	handle {
		reverse_proxy frontend:80
	}
}
